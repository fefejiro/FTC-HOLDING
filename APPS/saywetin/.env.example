# PostHog project API key from https://app.posthog.com
VITE_POSTHOG_KEY=

# PostHog ingestion host from https://app.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Admin credentials — REQUIRED; no built-in fallback. Rotate immediately if compromised.
SAYWETIN_ADMIN_USERNAME=your-admin-email@example.com
SAYWETIN_ADMIN_PASSWORD=
