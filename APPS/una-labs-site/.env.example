# Una Labs site environment variables
# Copy this file to .env.local and fill in the values.

# --- Supabase public auth client ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Temporary admin email allowlist backup (comma-separated) ---
# Example: mike.fejiro@gmail.com,fejiro.efiuvwere@gmail.com
NEXT_PUBLIC_UNALABS_ADMIN_EMAILS=

# --- Crisp live chat widget ---
# Sign up at https://crisp.chat (free plan, no credit card required)
# Leave empty to disable the chat widget without a code deploy.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# --- Google Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Site URL (used for metadata / OG tags) ---
NEXT_PUBLIC_SITE_URL=https://unalabs.cloud
