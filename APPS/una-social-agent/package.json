{
  "name": "una-social-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Una Labs Instagram and LinkedIn content generation, browser publishing, verification, and ledger agent.",
  "scripts": {
    "draft:today": "node scripts/draft-today.mjs",
    "asset:png": "node scripts/export-card-png.mjs",
    "publish:browser": "node scripts/publish-browser.mjs",
    "publish:browser:dry-run": "node scripts/publish-browser.mjs --dry-run",
    "publish:browser:fejiro:dry-run": "node scripts/publish-browser.mjs --dry-run --profile-dir \"%LOCALAPPDATA%\\Google\\Chrome\\User Data\" --chrome-profile-directory \"Profile 5\"",
    "publish:browser:fejiro": "node scripts/publish-browser.mjs --profile-dir \"%LOCALAPPDATA%\\Google\\Chrome\\User Data\" --chrome-profile-directory \"Profile 5\"",
    "publish:visible": "python scripts/visible-social-post.py",
    "publish:visible:dry-run": "python scripts/visible-social-post.py --dry-run",
    "browser:open-profile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-posting-browser.ps1",
    "browser:open-cdp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-posting-browser.ps1 -RemoteDebuggingPort 9222",
    "browser:open-fejiro-cdp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-posting-browser.ps1 -UseChromeProfile -ChromeProfileDirectory \"Profile 5\" -RemoteDebuggingPort 9222 -StartUrl \"https://www.linkedin.com/company/112328320/admin/dashboard/\"",
    "browser:detect-cdp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/detect-controlled-chrome.ps1",
    "browser:seed-profile": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed-posting-browser-profile.ps1",
    "post:record": "node scripts/record-posted.mjs",
    "engagement:monitor": "python scripts/visible-social-monitor.py",
    "quality:today": "node scripts/quality-check.mjs",
    "report:today": "node scripts/report-today.mjs",
    "schedule:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-weekly-social-schedule.ps1",
    "schedule:register:week": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-weekly-social-schedule.ps1",
    "schedule:run-now": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/social-run.ps1 -CaptionOnly",
    "schedule:status": "powershell -NoProfile -Command \"& { Get-ScheduledTask -TaskName 'UnaLabsSocial*' -ErrorAction SilentlyContinue | ForEach-Object { $info=$_ | Get-ScheduledTaskInfo; [pscustomobject]@{ TaskName=$_.TaskName; State=$_.State; LastRunTime=$info.LastRunTime; LastTaskResult=$info.LastTaskResult; NextRunTime=$info.NextRunTime } } } | Format-Table -AutoSize\"",
    "social:generate": "node scripts/social-publication.mjs generate-meta",
    "social:seed-feed": "node scripts/social-publication.mjs seed-feed",
    "social:preview": "node scripts/social-publication.mjs seed-feed",
    "social:qa": "node scripts/social-publication.mjs qa",
    "caption:write": "node scripts/caption-writer.mjs",
    "check": "node scripts/draft-today.mjs --date 2026-07-09 --dry-run --force-new"
  }
}
