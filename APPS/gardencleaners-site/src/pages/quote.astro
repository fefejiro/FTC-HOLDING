---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../content/site';
---
<BaseLayout title="Get a Free Quote — Garden Cleaners" description="Request a free cleaning quote from Garden Cleaners. Residential, commercial, deep, and move-in/move-out cleaning across Durham Region.">
  <section class="section">
    <div class="container-page grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <p class="eyebrow">Free quote request</p>
        <h1 class="h1 mt-2">Tell us what needs cleaning.</h1>
        <p class="lede mt-5">Share a few details about the property and the service you need. Garden Cleaners will follow up with the next step and a tailored estimate.</p>

        <div class="card mt-8">
          <h2 class="h3">What to include</h2>
          <ul class="mt-3 space-y-2 text-sm text-gc-ink/80">
            <li class="flex gap-2"><span class="mt-2 w-1.5 h-1.5 rounded-full bg-gc-leaf shrink-0"></span>Property type and approximate size</li>
            <li class="flex gap-2"><span class="mt-2 w-1.5 h-1.5 rounded-full bg-gc-leaf shrink-0"></span>Service required and frequency</li>
            <li class="flex gap-2"><span class="mt-2 w-1.5 h-1.5 rounded-full bg-gc-leaf shrink-0"></span>Preferred date and time window</li>
            <li class="flex gap-2"><span class="mt-2 w-1.5 h-1.5 rounded-full bg-gc-leaf shrink-0"></span>Any add-ons or special requests</li>
          </ul>
        </div>

        <div class="mt-6 text-sm space-y-2">
          <p><span class="font-semibold text-gc-ink">Prefer to call?</span> <a class="text-gc-moss hover:underline" href={site.phoneHref}>{site.phoneDisplay}</a></p>
          <p><span class="font-semibold text-gc-ink">Email:</span> <a class="text-gc-moss hover:underline" href={site.emailHref}>{site.email}</a></p>
        </div>

        <div class="mt-6 rounded-3xl overflow-hidden border border-black/5 aspect-[4/3]">
          <img src="/images/garden-cleaners/gc-washroom-cleaning.webp" alt="Detailed washroom cleaning during a deep clean visit." class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="card">
          <h2 class="h3">Request your quote</h2>
          <p class="mt-2 text-sm text-gc-ink/75">All fields are reviewed by the Garden Cleaners team.</p>
          <div class="mt-5">
            <QuoteForm source="quote_page" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
