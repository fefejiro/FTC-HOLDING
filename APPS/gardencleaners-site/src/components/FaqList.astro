---
import { faqs } from '../content/site';
---
<section class="section bg-white">
  <div class="container-page">
    <p class="eyebrow">Frequently asked</p>
    <h2 class="h2 mt-2">Quick answers about Garden Cleaners service.</h2>
    <div class="mt-8 grid gap-3 max-w-3xl">
      {faqs.map((f) => (
        <details class="card group">
          <summary class="font-semibold cursor-pointer flex items-center justify-between gap-4">
            <span>{f.question}</span>
            <span aria-hidden="true" class="text-gc-leaf transition-transform group-open:rotate-45 text-xl leading-none">+</span>
          </summary>
          <p class="mt-3 text-gc-ink/75 text-sm">{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
