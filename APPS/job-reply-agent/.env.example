# Auth mode: oauth (recommended) or smtp (fallback)
GMAIL_AUTH_MODE=oauth

# Gmail OAuth settings
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:3007/oauth2callback
GMAIL_TOKENS_PATH=./data/gmail_tokens.json
GMAIL_ACCOUNT_EMAIL=you@gmail.com

# Browser control surface for desktop and phone
JOB_AGENT_WEB_TOKEN=choose_a_long_random_token
PORT=3007
HOST=0.0.0.0

# SMTP fallback (used only when GMAIL_AUTH_MODE=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password

# Daily report recipient (set to same address for self-report)
REPORT_TO=you@gmail.com

# Agent runtime
AGENT_TZ=America/Toronto
DAILY_REPORT_ENABLE_SEND=true
