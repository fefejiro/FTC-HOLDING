NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=https://jobagent.example.com
# Runtime role must be NOSUPERUSER and NOBYPASSRLS.
DATABASE_URL=postgresql://jobagent_app:replace-me@postgres:5432/jobagent
# Owner credential is used only by `npm run product:migrate`.
MIGRATION_DATABASE_URL=postgresql://jobagent_migrator:replace-me@postgres:5432/jobagent
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_BUCKET=jobagent-private-resumes
OBJECT_STORAGE_REGION=ca-central-1
# Optional for Cloudflare R2, MinIO, or another S3-compatible provider.
# OBJECT_STORAGE_ENDPOINT=https://replace-me.example.com
# OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SSE=AES256
# For KMS: OBJECT_STORAGE_SSE=aws:kms and set OBJECT_STORAGE_KMS_KEY_ID.
JOB_AGENT_INVITE_CODE=replace-with-at-least-24-random-characters
AUTO_MIGRATE=false
