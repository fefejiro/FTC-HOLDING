NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=https://jobagent.unalabs.cloud
# Optional comma-separated trusted preview origins. Never use wildcards.
APP_ALLOWED_ORIGINS=
PUBLIC_SIGNUP_ENABLED=true
PUBLIC_SIGNUP_CAP=100
# Keep false until live Stripe catalog, webhook, entitlement, cancellation, and
# refund proof all pass. The API fails closed when this is absent or false.
BILLING_CHECKOUT_ENABLED=true
# Runtime role must be NOSUPERUSER and NOBYPASSRLS.
DATABASE_URL=postgresql://jobagent_app:replace-me@postgres:5432/jobagent
# Owner credential is injected only into the one-shot migration service.
MIGRATION_DATABASE_URL=postgresql://jobagent_migrator:replace-me@postgres:5432/jobagent
# pg-boss uses a separate non-superuser role limited to its own queue schema.
JOB_QUEUE_DATABASE_URL=postgresql://jobagent_queue:replace-me@postgres:5432/jobagent
JOB_QUEUE_SCHEMA=jobagent_queue
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
JOB_QUEUE_DATABASE_SSL=true
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_BUCKET=jobagent-private
OBJECT_STORAGE_REGION=ca-central-1
# Railway Bucket S3-compatible credentials.
AWS_ACCESS_KEY_ID=replace-with-private-bucket-access-key
AWS_SECRET_ACCESS_KEY=replace-with-private-bucket-secret-key
OBJECT_STORAGE_ENDPOINT=https://replace-with-private-bucket-endpoint
OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Railway Buckets reject S3 server-side-encryption headers. They remain private;
# use `none` for Railway, or AES256/aws:kms for providers that support it.
OBJECT_STORAGE_SSE=none
# For KMS: OBJECT_STORAGE_SSE=aws:kms and set OBJECT_STORAGE_KMS_KEY_ID.
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Optional when the public callback differs from APP_ORIGIN.
# GMAIL_PRODUCT_REDIRECT_URI=https://jobagent.unalabs.cloud/api/v1/oauth/gmail/callback
OAUTH_TOKEN_ACTIVE_KEY_VERSION=v1
# Each value must be a base64-encoded 32-byte key. Retain old versions while
# rotating so existing connections can still be decrypted and re-encrypted.
OAUTH_TOKEN_ENCRYPTION_KEYS={"v1":"replace-with-base64-encoded-32-byte-key"}
TRANSACTIONAL_EMAIL_FROM=Una Labs JobAgent <jobagent@unalabs.cloud>
# Existing Una Labs Cloudflare Worker gateway for Stripe and Mailjet.
JOBAGENT_BILLING_GATEWAY_URL=https://una-stripe-api.fejiro-efiuvwere.workers.dev
JOBAGENT_EMAIL_GATEWAY_URL=https://una-stripe-api.fejiro-efiuvwere.workers.dev
JOBAGENT_BILLING_SHARED_SECRET=replace-with-at-least-32-random-characters
# Optional Resend inbound-email support. Gmail connection remains available
# when these are omitted.
# RESEND_API_KEY=re_replace-with-resend-api-key
# RESEND_INBOUND_WEBHOOK_SECRET=whsec_replace-with-resend-webhook-secret
# INBOUND_EMAIL_DOMAIN=jobs.unalabs.cloud
# Prices are server-configurable; these are the approved launch defaults.
JOBAGENT_SPRINT_WEEKLY_CAD_CENTS=999
JOBAGENT_MONTHLY_CAD_CENTS=2999
JOBAGENT_ANNUAL_CAD_CENTS=23999
AUTO_MIGRATE=false
