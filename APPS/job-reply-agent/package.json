{
  "name": "job-reply-agent",
  "version": "0.1.0",
  "description": "Recruiter email intake, drafting, approval, and daily reporting agent.",
  "main": "dist/main.js",
  "scripts": {
    "test": "vitest run --exclude .local/** --exclude node_modules/** --exclude dist/**",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "serve": "tsx src/server.ts",
    "start": "node dist/main.js",
    "start:server": "node dist/server.js",
    "product:dev": "tsx src/product_server.ts",
    "product:start": "node dist/product_server.js",
    "product:migrate": "tsx src/product_migrate.ts",
    "product:migrate:prod": "node dist/product_migrate.js",
    "product:worker:dev": "tsx src/product_worker.ts",
    "product:worker": "node dist/product_worker.js",
    "product:admin": "node dist/product_admin.js",
    "product:pilot-import": "node dist/product_pilot_import.js",
    "runner:dev": "tsx src/product_runner_client.ts",
    "runner:start": "node dist/product_runner_client.js",
    "product:storage:migrate": "tsx src/product_storage_migrate.ts",
    "product:storage:cleanup": "tsx src/product_storage_cleanup.ts",
    "production:check": "node scripts/product-release-check.mjs",
    "production:check:strict": "node scripts/product-release-check.mjs --strict",
    "report": "tsx src/main.ts report:daily",
    "gmail:auth:url": "tsx src/main.ts gmail:auth:url",
    "gmail:auth:local": "tsx src/main.ts gmail:auth:local",
    "gmail:auth:save": "tsx src/main.ts gmail:auth:save",
    "gmail:status": "tsx src/main.ts gmail:status",
    "gmail:reconcile-sent": "tsx src/main.ts gmail:reconcile-sent",
    "instance:status": "tsx src/main.ts instance:status",
    "instance:onboarding-status": "tsx src/main.ts instance:onboarding-status",
    "instance:ready": "tsx src/main.ts instance:ready",
    "pilot:acceptance": "tsx src/pilot_acceptance.ts",
    "auth:doctor": "tsx src/main.ts auth:doctor",
    "db:reset": "tsx src/main.ts db:reset",
    "seed": "tsx src/main.ts seed:sample",
    "process:mock": "tsx src/main.ts process:mock",
    "process:gmail": "tsx src/main.ts process:gmail",
    "approve:all": "tsx src/main.ts approve:all",
    "send:approved": "tsx src/main.ts send:approved",
    "send:approved:gmail": "tsx src/main.ts send:approved:gmail",
    "run:mock-cycle": "tsx src/main.ts run:mock-cycle",
    "run:gmail-cycle": "tsx src/main.ts run:gmail-cycle",
    "run:cloud-cycle": "tsx src/main.ts run:cloud-cycle",
    "run:laptop-cycle": "tsx src/main.ts run:laptop-cycle",
    "run:production-cycle": "tsx src/main.ts run:production-cycle",
    "schedule:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-periodic-agent-task.ps1",
    "schedule:gmail:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-gmail-agent-task.ps1",
    "schedule:discovery:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-discovery-agent-task.ps1",
    "schedule:digest:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-daily-report-task.ps1",
    "schedule:discovery:run-now": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/discovery-run.ps1",
    "schedule:discovery:run-visible": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/discovery-run.ps1 -VisibleBrowser",
    "schedule:gmail:run-now": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gmail-run.ps1",
    "schedule:run-now": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daily-run.ps1",
    "schedule:run-browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daily-run.ps1 -BrowserCycle",
    "schedule:status": "powershell -NoProfile -Command \"Get-ScheduledTask | Where-Object { $_.TaskName -like 'JobReplyAgent-*' } | ForEach-Object { $info=$_ | Get-ScheduledTaskInfo; [pscustomobject]@{ TaskName=$_.TaskName; State=$_.State; LastRunTime=$info.LastRunTime; LastTaskResult=$info.LastTaskResult; NextRunTime=$info.NextRunTime } } | Format-Table -AutoSize\"",
    "browser:attach-chrome": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-chrome-cdp.ps1",
    "browser:fejiro-status": "python scripts/fejiro_chrome_status.py",
    "browser:instance-status": "python scripts/instance_chrome_status.py",
    "hunt:status": "tsx src/main.ts hunt:status",
    "hunt:scout": "tsx src/main.ts hunt:scout",
    "hunt:score": "tsx src/main.ts hunt:score",
    "hunt:package": "tsx src/main.ts hunt:package",
    "hunt:apply-assist": "tsx src/main.ts hunt:apply-assist",
    "hunt:apply-one": "tsx src/main.ts hunt:apply-one",
    "hunt:approve-submit": "tsx src/main.ts hunt:approve-submit",
    "hunt:interview-prep": "tsx src/main.ts hunt:interview-prep",
    "hunt:report": "tsx src/main.ts hunt:report",
    "hunt:export": "tsx src/main.ts hunt:export",
    "hunt:scrape-dice": "tsx src/main.ts hunt:scrape-dice",
    "hunt:scrape-dice:visible": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/visible-dice-cycle.ps1",
    "hunt:scrape-indeed": "tsx src/main.ts hunt:scrape-indeed",
    "hunt:scrape-indeed:visible": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/visible-indeed-cycle.ps1",
    "hunt:scrape-monster:visible": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/visible-monster-cycle.ps1",
    "hunt:indeed-visible-assist": "tsx scripts/indeed-visible-assist.ts",
    "hunt:scrape-linkedin": "tsx src/main.ts hunt:scrape-linkedin",
    "hunt:scrape-all": "tsx src/main.ts hunt:scrape-all",
    "hunt:dice-preflight": "tsx src/main.ts hunt:dice-preflight",
    "hunt:verify-dice-applied": "tsx src/main.ts hunt:verify-dice-applied",
    "hunt:verify-indeed-applied": "tsx src/main.ts hunt:verify-indeed-applied",
    "hunt:application-proof": "tsx src/main.ts hunt:application-proof",
    "hunt:reconcile-application-proof": "tsx src/main.ts hunt:reconcile-application-proof",
    "hunt:trust-report": "tsx src/main.ts hunt:trust-report",
    "hunt:premium-queue": "tsx src/main.ts hunt:premium-queue",
    "hunt:prepare-artifacts": "tsx src/main.ts hunt:prepare-artifacts",
    "lint": "node --check public/app.js && tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "better-sqlite3": "^13.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "gaxios": "^7.3.0",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "jszip": "^3.10.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.58.2",
    "qs": "^6.15.3",
    "resend": "^6.18.0",
    "ws": "^8.21.1",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.23",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "gaxios": "$gaxios"
  }
}
