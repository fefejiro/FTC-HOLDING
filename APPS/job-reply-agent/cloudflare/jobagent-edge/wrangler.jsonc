{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "una-jobagent-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "jobagent.unalabs.cloud",
      "custom_domain": true
    }
  ],
  "vars": {
    "JOBAGENT_ORIGIN": "https://jobagent-web-production.up.railway.app",
    "JOBAGENT_APPLE_APP_ID_PREFIX": "G6UNC88GQ5",
    "JOBAGENT_PLAY_APP_SIGNING_SHA256": "44:01:43:0D:08:16:50:11:86:87:48:F4:2D:B6:2C:F5:B6:8B:55:8B:D7:BA:2D:FC:FA:03:ED:5B:F2:8D:F8:AE"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
