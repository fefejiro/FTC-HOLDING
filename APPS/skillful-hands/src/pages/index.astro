---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../content/site";
import "../styles/global.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.canonical,
  email: site.email,
  description: site.description,
  sameAs: [site.instagram, site.linkedin]
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Skillful Hands CIC | Creating Skills. Building Futures.</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${site.name} | ${site.tagline}`} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={`${site.canonical}images/social-hero-workshop.webp`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Illustrative practical hair-learning workshop scene" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${site.name} | ${site.tagline}`} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={`${site.canonical}images/social-hero-workshop.webp`} />
    <meta name="theme-color" content="#D94F00" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <section class="hero">
        <div class="hero-copy-panel">
          <div class="container hero-content">
            <p class="eyebrow">Community skills and personal development</p>
            <h1>{site.hero.heading}</h1>
            <p class="hero-line">{site.hero.accent}</p>
            <p class="hero-copy">{site.description}</p>
            <p class="hero-statement">{site.hero.statement}</p>
            <div class="button-row">
              <a class="button button-hero" href="/programmes">{site.hero.cta} <span aria-hidden="true">&rarr;</span></a>
            </div>
          </div>
        </div>
        <div class="hero-media-panel">
          <div class="hero-slides" data-hero-slides aria-label="Workshop photographs">
            {site.heroSlides.map((slide, index) => (
              <figure class={`hero-slide ${index === 0 ? "is-active" : ""}`} data-hero-slide aria-hidden={index === 0 ? "false" : "true"}>
                <img src={`/images/${slide.image}.webp`} srcset={`/images/${slide.image}-640.webp 640w, /images/${slide.image}-960.webp 960w, /images/${slide.image}.webp 1440w`} sizes="(max-width: 820px) 100vw, 52vw" width="1440" height="1150" fetchpriority={index === 0 ? "high" : "auto"} loading={index === 0 ? "eager" : "lazy"} decoding="async" alt={slide.alt} style={`object-position: ${slide.position}`} />
              </figure>
            ))}
          </div>
          <div class="hero-controls" data-hero-controls>
            <div class="hero-dots" aria-label="Workshop photographs">
              {site.heroSlides.map((_, index) => <button type="button" aria-pressed={index === 0 ? "true" : "false"} aria-label={`Show workshop photograph ${index + 1}`} data-hero-to={index}></button>)}
            </div>
            <button class="hero-motion" type="button" data-hero-motion aria-label="Pause automatic workshop photographs">Pause photos</button>
          </div>
          <a class="hero-next" href="/programmes"><span>See what we offer</span><span aria-hidden="true">&rarr;</span></a>
        </div>
      </section>

      <section id="about" class="about-compact">
        <div class="container about-compact-grid">
          <div class="about-intro">
            <p class="eyebrow">Practical learning with purpose</p>
            <p>Hair is the engagement tool. What happens around it is much bigger.</p>
          </div>
          <div class="outcome-grid" aria-label="Our focus">
            {site.outcomes.map((item, index) => <p><span>0{index + 1}</span>{item}</p>)}
          </div>
        </div>
      </section>

      <section id="programmes" class="section programmes">
        <div class="container">
          <div class="programme-intro"><p class="eyebrow">Our programmes</p><h2>Five pathways. One purpose.</h2><p>Creating skills and building futures through practical learning, conversation and confidence.</p></div>
          <div class="programme-pathways">
            {site.programmes.map((item) => <a class={`programme-pathway tone-${item.tone}`} href={`/programmes#programme-${item.number}`}><span class="programme-icon" aria-hidden="true">{item.number}</span><strong>{item.title}</strong><small>{item.audience}</small></a>)}
          </div>
        </div>
      </section>

      <section id="founder" class="section founder">
        <div class="container founder-grid">
          <figure class="founder-portrait">
            <img src="/images/monique-hughes-cropped.webp" srcset="/images/monique-hughes-cropped-640.webp 640w, /images/monique-hughes-cropped-960.webp 960w, /images/monique-hughes-cropped.webp 1200w" sizes="(max-width: 820px) calc(100vw - 40px), 42vw" width="1200" height="1500" loading="lazy" decoding="async" alt="Monique Hughes, founder of Skillful Hands CIC" />
          </figure>
          <div>
            <p class="eyebrow">Meet the founder</p>
            <h2>{site.founder.name}</h2>
            <p class="founder-title">{site.founder.title}</p>
            {site.founder.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section class="section communities">
        <div class="container communities-grid">
          <div><p class="eyebrow">Working with our communities</p><h2>Designed around people and place.</h2><p>Skillful Hands works with young people, women and adults, with particular attention to people who may experience disadvantage, discrimination, racial inequality or barriers to opportunity.</p></div>
          <div class="community-panels"><article><h3>Who we support</h3><ul><li>Young people aged 13 to 25</li><li>Women rebuilding their lives</li><li>Adults seeking connection, confidence and practical skills</li><li>People experiencing social isolation or barriers to opportunity</li><li>Black and racially minoritised communities</li></ul></article><article><h3>Where we work</h3><p>Skillful Hands is based in South London, with programmes and partnerships being developed across London.</p><p class="area-list">Croydon <span>•</span> Bromley <span>•</span> Greenwich and Thamesmead <span>•</span> South London</p><p>We are also open to working with schools, community organisations, local authorities, justice services and partners in other London boroughs where there is an identified community need.</p></article></div>
        </div>
      </section>

      <section id="partners" class="section partners founder-follow">
        <div class="container">
          <div class="section-heading">
            <div><p class="eyebrow">Partner with us</p><h2>Bring practical opportunity closer.</h2></div>
            <p>We welcome conversations with organisations that care about skills, confidence, wellbeing, and economic opportunity.</p>
          </div>
          <div class="partner-grid">{site.partners.map((partner, index) => <article><h3>{partner.title}</h3><p>{partner.text}</p><a href={`/partner-with-us#partner-${index + 1}`}>Explore partnership options <span aria-hidden="true">&rarr;</span></a></article>)}</div>
        </div>
      </section>

      <section class="contact">
        <div class="container contact-inner">
          <div><p class="eyebrow">Let's make something meaningful</p><h2>Start with a conversation.</h2></div>
          <div><p>Interested in a programme, partnership, or community collaboration?</p><a class="button button-gold" href="/contact">Contact Skillful Hands CIC</a></div>
        </div>
      </section>
      <section class="follow-section"><div class="container follow-inner"><div><p class="eyebrow">Follow our journey</p><h2>Stay connected with Skillful Hands CIC.</h2></div><div class="social-actions"><a href={site.instagram} target="_blank" rel="noreferrer" aria-label="Follow Skillful Hands CIC on Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1"/></svg><span>Instagram</span></a><a href={site.linkedin} target="_blank" rel="noreferrer" aria-label="Follow Skillful Hands CIC on LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.5A2.5 2.5 0 1 0 5 8.5 2.5 2.5 0 0 0 5 3.5ZM3 9.5h4v11H3zM9.5 9.5h3.8V11c.8-1.2 2.1-1.9 4.1-1.9 3.2 0 4.6 2 4.6 5.4v6H18v-5.4c0-1.7-.6-2.7-2-2.7-1.6 0-2.5 1.1-2.5 3.2v4.9H9.5z"/></svg><span>LinkedIn</span></a></div></div></section>
    </main>
    <Footer />
    <script>
      const hero = document.querySelector<HTMLElement>("[data-hero-slides]");
      if (hero) {
        const heroSlides = [...hero.querySelectorAll<HTMLElement>("[data-hero-slide]")];
        const heroDots = [...document.querySelectorAll<HTMLButtonElement>("[data-hero-to]")];
        const heroMotion = document.querySelector<HTMLButtonElement>("[data-hero-motion]");
        const reduceHeroMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let heroCurrent = 0;
        let heroTimer: number | undefined;
        let heroPaused = reduceHeroMotion;
        const showHero = (next: number) => {
          heroCurrent = (next + heroSlides.length) % heroSlides.length;
          heroSlides.forEach((slide, index) => {
            slide.classList.toggle("is-active", index === heroCurrent);
            slide.setAttribute("aria-hidden", String(index !== heroCurrent));
          });
          heroDots.forEach((dot, index) => dot.setAttribute("aria-pressed", String(index === heroCurrent)));
        };
        const stopHero = () => window.clearInterval(heroTimer);
        const startHero = () => { stopHero(); if (!heroPaused) heroTimer = window.setInterval(() => showHero(heroCurrent + 1), 7000); };
        heroDots.forEach((dot, index) => dot.addEventListener("click", () => { showHero(index); startHero(); }));
        heroMotion?.addEventListener("click", () => {
          heroPaused = !heroPaused;
          heroMotion.textContent = heroPaused ? "Play photos" : "Pause photos";
          heroMotion.setAttribute("aria-label", heroPaused ? "Play automatic workshop photographs" : "Pause automatic workshop photographs");
          heroPaused ? stopHero() : startHero();
        });
        hero.addEventListener("mouseenter", stopHero);
        hero.addEventListener("mouseleave", startHero);
        document.addEventListener("visibilitychange", () => document.hidden ? stopHero() : startHero());
        if (heroMotion && reduceHeroMotion) { heroMotion.textContent = "Play photos"; heroMotion.setAttribute("aria-label", "Play automatic workshop photographs"); }
        startHero();
      }

    </script>
  </body>
</html>
