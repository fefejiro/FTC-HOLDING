---
import Header from "../components/Header.astro";
import { site } from "../content/site";
import "../styles/global.css";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.canonical,
  email: site.email,
  description: site.description
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Skillful Hands CIC | Practical Skills. Brighter Futures.</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={site.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${site.name} | ${site.tagline}`} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={`${site.canonical}images/workshop-braid-leader.webp`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A participant learning to braid hair during a Skillful Hands CIC workshop" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${site.name} | ${site.tagline}`} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={`${site.canonical}images/workshop-braid-leader.webp`} />
    <meta name="theme-color" content="#D94F00" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <section class="hero">
        <div class="hero-slides" data-hero-slides aria-label="Workshop photographs">
          {site.heroSlides.map((slide, index) => (
            <figure class={`hero-slide ${index === 0 ? "is-active" : ""}`} data-hero-slide aria-hidden={index === 0 ? "false" : "true"} style={`--hero-photo: url('/images/${slide.image}.webp')`}>
              <img
                src={`/images/${slide.image}.webp`}
                srcset={`/images/${slide.image}-640.webp 640w, /images/${slide.image}-960.webp 960w, /images/${slide.image}.webp 1440w`}
                sizes="100vw"
                width="1440"
                height="1920"
                fetchpriority={index === 0 ? "high" : "auto"}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                alt={slide.alt}
                style={`object-position: ${slide.position}`}
              />
            </figure>
          ))}
        </div>
        <div class="hero-overlay"></div>
        <div class="container hero-content">
          <p class="eyebrow">Community skills and personal development</p>
          <h1>Skillful Hands CIC</h1>
          <p class="hero-line">{site.tagline}</p>
          <p class="hero-copy">{site.description}</p>
          <div class="button-row">
            <a class="button" href="#programmes">Explore our programmes</a>
            <a class="text-link light" href={`mailto:${site.email}`}>Start a conversation <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
        <div class="hero-controls" data-hero-controls>
          <div class="hero-dots" aria-label="Workshop photographs">
            {site.heroSlides.map((_, index) => <button type="button" aria-pressed={index === 0 ? "true" : "false"} aria-label={`Show workshop photograph ${index + 1}`} data-hero-to={index}></button>)}
          </div>
          <button class="hero-motion" type="button" data-hero-motion aria-label="Pause automatic workshop photographs">Pause photos</button>
        </div>
        <a class="hero-next" href="#programmes"><span>See what we offer</span><span aria-hidden="true">&darr;</span></a>
      </section>

      <section id="about" class="about-compact">
        <div class="container about-compact-grid">
          <div class="about-intro">
            <p class="eyebrow">Practical learning with purpose</p>
            <p>We combine hair education with confidence-building, wellbeing, employability and entrepreneurship.</p>
          </div>
          <div class="outcome-grid" aria-label="Our focus">
            {site.outcomes.map((item, index) => <p><span>0{index + 1}</span>{item}</p>)}
          </div>
        </div>
      </section>

      <section id="programmes" class="section programmes">
        <div class="container">
          <div class="section-heading">
            <div><p class="eyebrow">Explore our programmes</p><h2>One practical skill. Many possibilities.</h2></div>
            <p>Choose a programme to see how learning, conversation and confidence come together.</p>
          </div>
          <div class="showcase" data-showcase>
            <div class="showcase-tabs" role="tablist" aria-label="Programme slides">
              {site.showcase.map((item, index) => (
                <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`programme-panel-${index}`} id={`programme-tab-${index}`} data-slide-to={index}>
                  <span>{String(index + 1).padStart(2, "0")}</span>{item.label}
                </button>
              ))}
            </div>
            <div class="showcase-window">
              <div class="showcase-track">
                {site.showcase.map((item, index) => (
                  <article class={`showcase-slide tone-${item.tone}`} id={`programme-panel-${index}`} role="tabpanel" aria-labelledby={`programme-tab-${index}`} aria-hidden={index === 0 ? "false" : "true"}>
                    <div class="showcase-copy">
                      <p class="showcase-audience">{item.audience}</p>
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                      <ul>{item.focus.map((focus) => <li>{focus}</li>)}</ul>
                    </div>
                    <div class="showcase-visual" aria-hidden="true">
                      <span class="visual-word">Learn</span>
                      <span class="visual-word">Connect</span>
                      <span class="visual-word">Grow</span>
                      <div class="visual-mark">SH</div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
            <div class="showcase-controls">
              <button type="button" class="round-control" data-previous aria-label="Previous programme">&#8592;</button>
              <p aria-live="polite"><span data-current>1</span> / {site.showcase.length}</p>
              <button type="button" class="round-control" data-next aria-label="Next programme">&#8594;</button>
              <button type="button" class="motion-control" data-motion aria-label="Pause automatic programme slides">Pause</button>
            </div>
          </div>
        </div>
      </section>

      <section id="founder" class="section founder">
        <div class="container founder-grid">
          <figure class="founder-portrait">
            <img src="/images/monique-hughes.webp" srcset="/images/monique-hughes-640.webp 640w, /images/monique-hughes-960.webp 960w, /images/monique-hughes.webp 1200w" sizes="(max-width: 820px) calc(100vw - 40px), 42vw" width="1200" height="1802" loading="lazy" decoding="async" alt="Monique Hughes, founder of Skillful Hands CIC, standing near the London Eye" />
          </figure>
          <div>
            <p class="eyebrow">Meet the founder</p>
            <h2>{site.founder.name}</h2>
            <p class="founder-title">{site.founder.title}</p>
            {site.founder.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section id="partners" class="section partners founder-follow">
        <div class="container">
          <div class="section-heading">
            <div><p class="eyebrow">Partner with us</p><h2>Bring practical opportunity closer.</h2></div>
            <p>We welcome conversations with organisations that care about skills, confidence, wellbeing, and economic opportunity.</p>
          </div>
          <div class="partner-grid">{site.partners.map((partner) => <article><h3>{partner.title}</h3><p>{partner.text}</p><a href={`mailto:${site.email}?subject=Partnership enquiry`}>Start a conversation <span aria-hidden="true">&rarr;</span></a></article>)}</div>
        </div>
      </section>

      <section class="contact">
        <div class="container contact-inner">
          <div><p class="eyebrow">Let's make something meaningful</p><h2>Start with a conversation.</h2></div>
          <div><p>Interested in a programme, partnership, or community collaboration?</p><a class="button button-gold" href={`mailto:${site.email}`}>Email Skillful Hands CIC</a></div>
        </div>
      </section>
    </main>
    <footer>
      <div class="container footer-grid">
        <div><a class="brand footer-brand" href="#top"><span class="brand-mark">SH</span><span>{site.name}</span></a><p>{site.tagline}</p></div>
        <div><p class="footer-label">Contact</p><a href={`mailto:${site.email}`}>{site.email}</a></div>
        <div><p class="footer-label">Navigate</p>{site.nav.slice(0, 3).map((item) => <a href={item.href}>{item.label}</a>)}</div>
      </div>
      <div class="container footer-bottom"><p>&copy; {new Date().getFullYear()} Skillful Hands CIC</p><p>Community interest. Practical opportunity.</p></div>
    </footer>
    <script>
      const hero = document.querySelector<HTMLElement>("[data-hero-slides]");
      if (hero) {
        const heroSlides = [...hero.querySelectorAll<HTMLElement>("[data-hero-slide]")];
        const heroDots = [...document.querySelectorAll<HTMLButtonElement>("[data-hero-to]")];
        const heroMotion = document.querySelector<HTMLButtonElement>("[data-hero-motion]");
        const reduceHeroMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let heroCurrent = 0;
        let heroTimer: number | undefined;
        let heroPaused = reduceHeroMotion;
        const showHero = (next: number) => {
          heroCurrent = (next + heroSlides.length) % heroSlides.length;
          heroSlides.forEach((slide, index) => {
            slide.classList.toggle("is-active", index === heroCurrent);
            slide.setAttribute("aria-hidden", String(index !== heroCurrent));
          });
          heroDots.forEach((dot, index) => dot.setAttribute("aria-pressed", String(index === heroCurrent)));
        };
        const stopHero = () => window.clearInterval(heroTimer);
        const startHero = () => { stopHero(); if (!heroPaused) heroTimer = window.setInterval(() => showHero(heroCurrent + 1), 7000); };
        heroDots.forEach((dot, index) => dot.addEventListener("click", () => { showHero(index); startHero(); }));
        heroMotion?.addEventListener("click", () => {
          heroPaused = !heroPaused;
          heroMotion.textContent = heroPaused ? "Play photos" : "Pause photos";
          heroMotion.setAttribute("aria-label", heroPaused ? "Play automatic workshop photographs" : "Pause automatic workshop photographs");
          heroPaused ? stopHero() : startHero();
        });
        hero.addEventListener("mouseenter", stopHero);
        hero.addEventListener("mouseleave", startHero);
        document.addEventListener("visibilitychange", () => document.hidden ? stopHero() : startHero());
        if (heroMotion && reduceHeroMotion) { heroMotion.textContent = "Play photos"; heroMotion.setAttribute("aria-label", "Play automatic workshop photographs"); }
        startHero();
      }

      const showcase = document.querySelector<HTMLElement>("[data-showcase]");
      if (showcase) {
        const track = showcase.querySelector<HTMLElement>(".showcase-track");
        const slides = [...showcase.querySelectorAll<HTMLElement>(".showcase-slide")];
        const tabs = [...showcase.querySelectorAll<HTMLButtonElement>("[data-slide-to]")];
        const currentLabel = showcase.querySelector<HTMLElement>("[data-current]");
        const motionButton = showcase.querySelector<HTMLButtonElement>("[data-motion]");
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let current = 0;
        let timer: number | undefined;
        let manuallyPaused = reduceMotion;

        const show = (next: number, focusTab = false) => {
          current = (next + slides.length) % slides.length;
          if (track) track.style.transform = `translateX(-${current * 100}%)`;
          slides.forEach((slide, index) => slide.setAttribute("aria-hidden", String(index !== current)));
          tabs.forEach((tab, index) => {
            tab.setAttribute("aria-selected", String(index === current));
            tab.tabIndex = index === current ? 0 : -1;
          });
          if (currentLabel) currentLabel.textContent = String(current + 1);
          if (focusTab) tabs[current]?.focus();
        };
        const stop = () => window.clearInterval(timer);
        const start = () => {
          stop();
          if (!manuallyPaused) timer = window.setInterval(() => show(current + 1), 6500);
        };

        tabs.forEach((tab, index) => {
          tab.addEventListener("click", () => { show(index); start(); });
          tab.addEventListener("keydown", (event) => {
            if (event.key === "ArrowRight") show(current + 1, true);
            if (event.key === "ArrowLeft") show(current - 1, true);
          });
        });
        showcase.querySelector("[data-previous]")?.addEventListener("click", () => { show(current - 1); start(); });
        showcase.querySelector("[data-next]")?.addEventListener("click", () => { show(current + 1); start(); });
        motionButton?.addEventListener("click", () => {
          manuallyPaused = !manuallyPaused;
          motionButton.textContent = manuallyPaused ? "Play" : "Pause";
          motionButton.setAttribute("aria-label", manuallyPaused ? "Play automatic programme slides" : "Pause automatic programme slides");
          manuallyPaused ? stop() : start();
        });
        showcase.addEventListener("mouseenter", stop);
        showcase.addEventListener("mouseleave", start);
        showcase.addEventListener("focusin", stop);
        showcase.addEventListener("focusout", start);
        document.addEventListener("visibilitychange", () => document.hidden ? stop() : start());
        show(0);
        if (motionButton && reduceMotion) {
          motionButton.textContent = "Play";
          motionButton.setAttribute("aria-label", "Play automatic programme slides");
        }
        start();
      }
    </script>
  </body>
</html>
