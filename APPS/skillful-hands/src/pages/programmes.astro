---
import PageLayout from "../layouts/PageLayout.astro";
import { site } from "../content/site";
---
<PageLayout title="Programmes | Skillful Hands CIC" description="Explore practical hair education and confidence-building programmes from Skillful Hands CIC.">
  <section class="interior-hero"><div class="container"><p class="eyebrow">Our programmes</p><h1>One practical skill. Many possibilities.</h1><p>Each programme brings practical learning together with confidence-building, wellbeing and future-focused support.</p></div></section>
  <section class="section"><div class="container programme-page-grid">{site.programmes.map((programme) => <article class={`programme-page-card tone-${programme.tone}`}><img src={`/images/${programme.image}.webp`} width="1440" height="1920" loading="lazy" decoding="async" alt={programme.imageAlt} /><div class="programme-page-content"><p class="programme-index">{programme.number}</p><p class="showcase-audience">{programme.audience}</p><h2>{programme.title}</h2><p class="programme-strapline">{programme.strapline}</p><p>{programme.description}</p><p>{programme.detail}</p><ul>{programme.focus.map((focus) => <li>{focus}</li>)}</ul><a class="button button-light" href={`/contact?interest=${encodeURIComponent(programme.title)}`}>Ask about this programme</a></div></article>)}</div></section>
</PageLayout>
