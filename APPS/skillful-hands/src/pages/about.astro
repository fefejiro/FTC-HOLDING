---
import PageLayout from "../layouts/PageLayout.astro";
import { site } from "../content/site";
---
<PageLayout title="About Skillful Hands CIC | Creating Skills. Building Futures." description="Learn about Skillful Hands CIC and founder Monique Hughes.">
  <section class="interior-hero"><div class="container"><p class="eyebrow">About Skillful Hands CIC</p><h1>Practical learning with purpose.</h1><p>Hair education can be a starting point for confidence, connection, creativity and opportunity.</p></div></section>
  <section class="section"><div class="container narrative-grid"><div><p class="eyebrow">What we do</p><h2>Skills that reach beyond the session.</h2></div><div class="large-copy"><p>Skillful Hands CIC is a Community Interest Company dedicated to helping people build confidence, practical skills and brighter futures through hair education and personal development.</p><p>Our programmes combine technical hair training with life skills, employability, wellbeing and entrepreneurship, creating routes towards education, employment and self-employment.</p><a class="button" href="/programmes">Explore programmes</a></div></div></section>
  <section id="founder" class="section founder"><div class="container founder-grid"><figure class="founder-portrait"><img src="/images/monique-hughes.webp" srcset="/images/monique-hughes-640.webp 640w, /images/monique-hughes-960.webp 960w, /images/monique-hughes.webp 1200w" sizes="(max-width: 820px) calc(100vw - 40px), 42vw" width="1200" height="1802" loading="lazy" decoding="async" alt="Monique Hughes, founder of Skillful Hands CIC, standing near the London Eye" /></figure><div><p class="eyebrow">Meet the founder</p><h2>{site.founder.name}</h2><p class="founder-title">{site.founder.title}</p>{site.founder.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<a class="text-link" href="/contact">Start a conversation <span aria-hidden="true">&rarr;</span></a></div></div></section>
</PageLayout>
