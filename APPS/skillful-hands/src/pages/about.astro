---
import PageLayout from "../layouts/PageLayout.astro";
import { site } from "../content/site";
---
<PageLayout title="About Skillful Hands CIC | Creating Skills. Building Futures." description="Learn about Skillful Hands CIC and founder Monique Hughes.">
  <section class="interior-hero"><div class="container"><p class="eyebrow">About Skillful Hands CIC</p><h1>Practical learning with purpose.</h1><p>Hair education can be a starting point for confidence, connection, creativity and opportunity.</p></div></section>
  <section class="section"><div class="container narrative-grid"><div><p class="eyebrow">What we do</p><h2>Hair is the engagement tool.</h2></div><div class="large-copy"><p>Skillful Hands CIC uses practical hair skills to create welcoming spaces for learning, meaningful conversations and personal development.</p><p>Our programmes bring together hands-on learning, wellbeing, relationships, confidence, life skills and future opportunities, creating spaces where young people and adults can learn, connect and talk without judgement.</p><p>What happens around the hair activity is much bigger.</p><a class="button" href="/programmes">Explore programmes</a></div></div></section>
  <section class="section mission-vision"><div class="container mission-grid"><article><p class="eyebrow">Our mission</p><h2>Practical learning. Meaningful connection.</h2>{site.mission.map((paragraph) => <p>{paragraph}</p>)}</article><article><p class="eyebrow">Our vision</p><h2>Communities with a voice.</h2>{site.vision.map((paragraph) => <p>{paragraph}</p>)}</article></div></section>
  <section class="section values"><div class="container"><div class="section-heading"><div><p class="eyebrow">Our values</p><h2>What guides our work.</h2></div><p>Our programmes are shaped by practical learning, inclusion and respect for every person’s potential.</p></div><div class="values-grid">{site.values.map((value, index) => <article><span>0{index + 1}</span><h3>{value.title}</h3><p>{value.text}</p></article>)}</div></div></section>
  <section id="founder" class="section founder"><div class="container founder-grid"><figure class="founder-portrait"><img src="/images/monique-hughes-cropped.webp" srcset="/images/monique-hughes-cropped-640.webp 640w, /images/monique-hughes-cropped-960.webp 960w, /images/monique-hughes-cropped.webp 1200w" sizes="(max-width: 820px) calc(100vw - 40px), 42vw" width="1200" height="1500" loading="lazy" decoding="async" alt="Monique Hughes, founder of Skillful Hands CIC" /></figure><div><p class="eyebrow">Meet the founder</p><h2>{site.founder.name}</h2><p class="founder-title">{site.founder.title}</p>{site.founder.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<a class="text-link" href="/contact">Start a conversation <span aria-hidden="true">&rarr;</span></a></div></div></section>
</PageLayout>
