{
  "name": "saywetin-native",
  "version": "1.3.4",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "postinstall": "node ops/patch-react-native-gradle.cjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "android:readiness": "node ops/android-readiness.cjs",
    "android:test:preflight": "node ops/android-test-loop.cjs preflight",
    "android:test:run": "node ops/android-test-loop.cjs run",
    "android:test:expo-go": "expo start --tunnel",
    "version:show": "node ops/version-governance.cjs show",
    "version:sync": "node ops/version-governance.cjs sync",
    "version:bump:patch": "node ops/version-governance.cjs bump patch",
    "version:bump:minor": "node ops/version-governance.cjs bump minor",
    "version:bump:major": "node ops/version-governance.cjs bump major",
    "version:set": "node ops/version-governance.cjs bump set",
    "release:patch": "npm run version:bump:patch && npm run android:test:preflight",
    "release:minor": "npm run version:bump:minor && npm run android:test:preflight",
    "release:major": "npm run version:bump:major && npm run android:test:preflight",
    "play:internal": "node ops/play-publish.cjs --track=internal",
    "play:beta": "node ops/play-publish.cjs --track=beta",
    "play:production": "node ops/play-publish.cjs --track=production --rollout=0.2",
    "play:promote:internal-to-prod": "node ops/play-publish.cjs --promote --from=internal --to=production --rollout=0.2"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@react-native/virtualized-lists": "^0.81.5",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "^0.85.2",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
