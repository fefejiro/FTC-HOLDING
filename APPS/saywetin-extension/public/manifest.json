{
  "manifest_version": 3,
  "name": "SayWetin: African Lyrics Decoder",
  "description": "Tap to recognize any African song in your browser tab and instantly see the lyrics, translation, and cultural meaning.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabCapture",
    "storage",
    "identity",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://saywetin.app/*",
    "https://*.saywetin.app/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
