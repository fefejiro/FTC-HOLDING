{
  "name": "@ftc/anion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4178",
    "build": "next build",
    "start": "next start -p 4178",
    "check": "tsc --noEmit",
    "test": "tsx --test app/lib/security/__tests__/*.test.ts",
    "test:e2e": "playwright test",
    "ci:check": "npm run check && npm run build",
