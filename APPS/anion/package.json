    "@supabase/supabase-js": "^2.105.3",
    "lightningcss": "^1.32.0",
    "next": "^15.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0-beta.3",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.29",
