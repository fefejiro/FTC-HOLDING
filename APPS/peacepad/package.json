    "scripts":  {
                    "dev":  "cross-env NODE_ENV=development tsx server/index.ts",
                    "clean":  "node scripts/clean-build-artifacts.mjs",
                    "prebuild":  "npm run clean",
                    "build:frontend":  "node scripts/write-web-build-meta.mjs \u0026\u0026 vite build \u0026\u0026 node scripts/report-bundle-size.mjs \u0026\u0026 npm run verify:no-replit-domains",
