                    "verify:no-replit-domains":  "node scripts/verify-no-replit-domains.mjs",
                    "check":  "tsc",
                    "test":  "vitest run",
                    "db:push":  "drizzle-kit push",
                    "test:report":  "node scripts/generateTestSummary.cjs",
                    "smoke:guest-auth":  "node scripts/smoke-guest-auth.mjs",
