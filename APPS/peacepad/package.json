                    "verify:deployment-ownership":  "node scripts/verify-deployment-ownership.mjs",
                    "guard:openai-secrets":  "node scripts/guard-openai-secrets.mjs",
                    "guard:openai-secrets:all":  "node scripts/guard-openai-secrets.mjs --all",
