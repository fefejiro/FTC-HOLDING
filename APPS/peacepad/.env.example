# PeacePad backend/runtime configuration
# Copy to .env for local development. Never commit real secret values.

# Runtime
NODE_ENV=production
PORT=5000
# Deployment role:
# - api: backend-only host (recommended for Railway production at api.peacepad.ca)
# - fullstack: serves API + static frontend from the same process
DEPLOY_ROLE=api

# Public/app origins
# PUBLIC_BASE_URL should be the externally reachable API base URL.
PUBLIC_BASE_URL=https://api.peacepad.ca
# APP_ORIGINS are trusted application origins/hosts used for auth + CSP.
APP_ORIGINS=https://peacepad.ca
# CORS_ALLOWED_ORIGINS are additional allowed browser origins (comma-separated).
CORS_ALLOWED_ORIGINS=https://peacepad.ca
CORS_ALLOW_CREDENTIALS=true

# Session
SESSION_SECRET=replace-with-long-random-secret

# Database
# Use DATABASE_URL directly, or PGHOST/PGUSER/PGPASSWORD/PGDATABASE fallback.
DATABASE_URL=postgresql://user:password@host:5432/database
# Optional alternate direct connection URL used by some tooling/providers.
DIRECT_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-openai-key
# Legacy aliases still supported by code:
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
# Privacy release gates: both remain disabled unless a later reviewed release
# explicitly enables them and the user has separately opted in.
PEACEPAD_ENABLE_V2_EXTERNAL_AI=false
PEACEPAD_ENABLE_PATTERN_LEARNING=false

# Voice / TTS
VITS_BASE_URL=https://your-vits-service.example.com

# Web Push (VAPID)
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_EMAIL=mailto:peacepad@peacepad.ca

# Firebase service account (choose one approach)
# Recommended: provide a local file path (not committed) that contains the JSON key.
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=./secrets/firebase-service-account.json
# Alternative: inline JSON string (harder to manage safely).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email (Mailjet)
MAILJET_API_KEY=replace-with-mailjet-api-key
MAILJET_SECRET_KEY=replace-with-mailjet-secret

# Auth provider (optional; required only for OIDC login/callback routes)
OIDC_CLIENT_ID=
OIDC_ISSUER_URL=https://replit.com/oidc

# Supabase auth exchange (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Isolated App Review account (disabled unless explicitly enabled).
# Keep the email, user ID, and hash in deployment secrets only. The password
# hash format is: pbkdf2-sha256$210000$<hex-salt>$<64-char-hex-digest>.
PEACEPAD_REVIEWER_LOGIN_ENABLED=false
PEACEPAD_REVIEWER_EMAIL=
PEACEPAD_REVIEWER_PASSWORD_HASH=
PEACEPAD_REVIEWER_USER_ID=

# Frontend links used in emails
VITE_BASE_URL=https://peacepad.ca
ADMIN_EMAIL=peacepad@peacepad.ca

# Optional integrations/features
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ONTARIO_211_API_KEY=
SAFETY_PLAN_MASTER_KEY=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
ALLOW_TEST_SEEDING=false
USE_REAL_AI=true
ALLOW_DEV_AI=false
