{
  "name": "@ftc/ftc-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build:deps": "npm run build --workspace=@ftc/config && npm run build --workspace=@ftc/types && npm run build --workspace=@ftc/logger && npm run build --workspace=@ftc/supabase && npm run build --workspace=@ftc/auth",
    "prebuild": "npm run build:deps",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test": "npm run test:e2e",
    "check": "npm run lint && npm run build && npm run test:e2e",
    "worker:deploy:dry-run": "npx wrangler deploy --dry-run",
    "worker:dev": "npx wrangler dev"
  },
  "dependencies": {
    "@ftc/config": "1.0.0",
    "@ftc/logger": "1.0.0",
    "@ftc/types": "1.0.0",
    "@ftc/supabase": "0.0.0",
    "@ftc/auth": "0.0.0",
    "next": "^14.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.4.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "8.0.0",
    "eslint-config-next": "14.2.35",
    "typescript": "^5.3.3",
    "@playwright/test": "^1.38.0"
  }
}
