{
  "name": "@ftc/ftc-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build:deps": "npm run build --workspace=@ftc/config && npm run build --workspace=@ftc/types && npm run build --workspace=@ftc/logger && npm run build --workspace=@ftc/supabase && npm run build --workspace=@ftc/auth",
    "prebuild": "npm run build:deps",
    "build": "next build && node scripts/fix-vercel-monorepo-output.mjs",
    "start": "next start",
    "lint": "next lint",
    "pipeline:update": "node scripts/update-pipeline-stage.mjs",
    "portal:env:check": "node scripts/verify-garden-portal-env.mjs",
    "test:e2e": "playwright test",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "test": "npm run test:e2e",
    "check": "npm run lint && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@ftc/auth": "0.0.0",
    "@ftc/config": "1.0.0",
    "@ftc/logger": "1.0.0",
    "@ftc/supabase": "0.0.0",
    "@ftc/types": "1.0.0",
    "@supabase/phoenix": "^0.4.1",
    "clsx": "^2.1.1",
    "next": "^14.2.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^22.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.38.0",
    "@types/node": "^20.4.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "typescript": "^5.3.3"
  }
}
