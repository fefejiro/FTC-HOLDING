# FTC Site environment variables
# Copy this file to .env.local and fill in the values.

# --- Crisp live chat widget ---
# Sign up at https://crisp.chat (free plan, no credit card required)
# Leave empty to disable the chat widget without a code deploy.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# --- Google Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Search Console ---
GOOGLE_SITE_VERIFICATION=

# --- Garden Cleaners portal (required for credentialed portal flows) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://gardencleaners.ca

# Optional admin extension list (comma-separated)
NEXT_PUBLIC_GARDEN_PORTAL_ADMIN_EMAILS=

# Optional notifications
RESEND_API_KEY=
GARDEN_CLEANERS_ADMIN_EMAIL=
GARDEN_CLEANERS_ADMIN_EMAIL_FROM=
GARDEN_CLEANERS_QUOTE_WEBHOOK_URL=
