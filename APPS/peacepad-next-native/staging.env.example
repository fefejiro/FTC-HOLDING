# Fictional staging only. Never use production hosts, tokens, or family data.
PEACEPAD_RUNTIME_ENV=staging
PORT=8787
PEACEPAD_SERVICE_ORIGIN=https://api.staging.peacepad.ca
PEACEPAD_STAGING_APP_ORIGIN=https://app.staging.peacepad.ca
PEACEPAD_STAGING_DATABASE_URL=postgresql://staging_user:replace-me@localhost:5432/peacepad_staging
PEACEPAD_STAGING_REGION=ca
PEACEPAD_STAGING_SESSION_PEPPER=replace-with-a-secret-at-runtime
PEACEPAD_STAGING_SESSION_TOKEN_HASH=replace-with-64-char-sha256
PEACEPAD_STAGING_ACTOR_ID=fictional-actor-ca
PEACEPAD_STAGING_ACTOR_DISPLAY_NAME=Fictional Reviewer
PEACEPAD_STAGING_SESSION_ID=fictional-session-ca
PEACEPAD_STAGING_FAMILIES_JSON={"family-fictional-ca":"Example Family CA"}
PEACEPAD_STAGING_FAMILY_PERMISSIONS_JSON={"family-fictional-ca":["read:family","write:message"]}
