{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["src/*"],
      "expo": ["src/types/expo"],
      "react-native": ["src/types/react-native"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["react"]
  },
  "include": ["src", "index.ts"]
}
