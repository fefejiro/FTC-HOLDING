# Server-only staging configuration. Never expose these as EXPO_PUBLIC values.
PEACEPAD_RUNTIME_ENV=staging
PEACEPAD_SERVICE_ORIGIN=https://api.staging.peacepad.ca
PEACEPAD_STAGING_APP_ORIGIN=https://app.staging.peacepad.ca
# Migration credentials own the staging schema. Runtime credentials are a
# separate least-privilege role and must never be interchangeable.
PEACEPAD_STAGING_MIGRATION_DATABASE_URL=
PEACEPAD_STAGING_RUNTIME_DATABASE_URL=
PEACEPAD_STAGING_RUNTIME_ROLE=peacepad_native_staging_runtime
PEACEPAD_INVITATION_PEPPER=
PEACEPAD_RATE_LIMIT_PEPPER=
PEACEPAD_IDEMPOTENCY_PEPPER=
PEACEPAD_STAGING_SESSION_PEPPER=
PEACEPAD_STAGING_FAMILIES_JSON={"family-staging":"Example family"}
# Hash each fictional bearer token as SHA-256("<session pepper>:<token>").
# Store only the hashes here; never commit, log, or place bearer tokens in EXPO_PUBLIC values.
PEACEPAD_STAGING_ACTORS_JSON=[{"tokenHash":"<64-hex-hash>","identityId":"synthetic-alex","displayName":"Alex Example","sessionId":"synthetic-alex-session","familyPermissions":{"family-staging":["invite","calendar:read","calendar:write","messages:read","messages:write"]}},{"tokenHash":"<different-64-hex-hash>","identityId":"synthetic-jordan","displayName":"Jordan Example","sessionId":"synthetic-jordan-session","familyPermissions":{"family-staging":["calendar:read","calendar:write","messages:read","messages:write"]}}]
