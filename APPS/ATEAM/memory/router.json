{
  "version": 1,
  "rules": {
    "forcedAgentWins": true,
    "taskAssignmentWins": true,
    "fallbackAgent": "Coach"
  },
  "routing": [
    { "ifContains": ["bug", "error", "fix", "code", "server", "api", "endpoint"], "agent": "Builder", "room": "appsLab" },
    { "ifContains": ["research", "compare", "market", "salary", "job", "trend"], "agent": "Scout", "room": "jobsCommand" },
    { "ifContains": ["strategy", "roadmap", "architecture", "plan", "decision"], "agent": "Coach", "room": "strategyCore" },
    { "ifContains": ["risk", "unknown", "think", "tradeoff", "learn"], "agent": "Think Tank", "room": "thinkTank" }
  ],
  "memoryInjection": {
    "maxGlobalItems": 12,
    "maxRoomItems": 10,
    "maxThreadMessages": 14
  }
}
