LLM_MODE=openai
ATEAM_STORAGE_BACKEND=local
ATEAM_AUTH_MODE=local
# ATEAM_AUTH_MODE options: local | header | jwt
ATEAM_LOCAL_TENANT_ID=local_tenant
ATEAM_LOCAL_WORKSPACE_ID=local_workspace
ATEAM_LOCAL_USER_ID=local_user
OPENAI_API_KEY=your_openai_api_key_here

# Capability contracts
ATEAM_CAPABILITY_CONTRACT_VERSION=v1alpha1

# Supabase adapter scaffold (used when ATEAM_STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_AUDIO=ateam-audio

OPENAI_MODEL_TALK_PRIMARY=gpt-4o
OPENAI_MODEL_TALK_FALLBACK=gpt-4o-mini
OPENAI_MODEL_DASH_PRIMARY=gpt-4o-mini
OPENAI_MODEL_DASH_FALLBACK=gpt-4o-mini

OPENAI_TEMP_TALK=0.90
OPENAI_TEMP_DASH=0.55

OPENAI_STREAM_TALK=true
OPENAI_STREAM_DASH=false
OPENAI_TIMEOUT_MS=45000

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_PROF=
ELEVENLABS_VOICE_DEFAULT=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_MS=20000

# Optional shared fallback if per-mode values are not set
OPENAI_MODEL=gpt-4o-mini
