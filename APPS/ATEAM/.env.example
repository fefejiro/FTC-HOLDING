LLM_MODE=openai
# For local no-key testing, set LLM_MODE=stub
ATEAM_STORAGE_BACKEND=local
ATEAM_AUTH_MODE=local
# ATEAM_AUTH_MODE options: local | header | jwt | trusted_proxy
ATEAM_PUBLIC_SERVICE_MODE=false
ATEAM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
ATEAM_LOCAL_TENANT_ID=local_tenant
ATEAM_LOCAL_WORKSPACE_ID=local_workspace
ATEAM_LOCAL_USER_ID=local_user
ATEAM_TRUSTED_PROXY_KEY=
ATEAM_OPERATOR_AUDIT_SESSION_ID=operator_audit
OPENAI_API_KEY=sk-YOUR-OPENAI-API-KEY-HERE

# Capability contracts
ATEAM_CAPABILITY_CONTRACT_VERSION=v1alpha1

# Supabase durable workflow backend
# Recommended managed path: ATEAM_STORAGE_BACKEND=postgres with ATEAM_DATABASE_URL or DATABASE_URL.
# Optional REST path: ATEAM_STORAGE_BACKEND=supabase with SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
ATEAM_DATABASE_URL=
ATEAM_DATABASE_SSL_NO_VERIFY=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_AUDIO=ateam-audio
SUPABASE_TABLE_ATEAM_APPROVALS=ateam_approvals
SUPABASE_TABLE_ATEAM_WORK_ITEMS=ateam_work_items
SUPABASE_TABLE_ATEAM_WORKFLOW_RUNS=ateam_workflow_runs

OPENAI_MODEL_TALK_PRIMARY=gpt-4o
OPENAI_MODEL_TALK_FALLBACK=gpt-4o-mini
OPENAI_MODEL_DASH_PRIMARY=gpt-4o-mini
OPENAI_MODEL_DASH_FALLBACK=gpt-4o-mini

OPENAI_TEMP_TALK=0.90
OPENAI_TEMP_DASH=0.55

OPENAI_STREAM_TALK=true
OPENAI_STREAM_DASH=false
OPENAI_TIMEOUT_MS=45000

# Remote bridge
ATEAM_KEY=change_me
ATEAM_BRIDGE_ALLOWED_ORIGINS=*

# Phone voice UI (phone.js)
ANTHROPIC_API_KEY=sk-ant-YOUR-ANTHROPIC-API-KEY-HERE
PHONE_PORT=3002
ATEAM_BRIDGE_URL=http://127.0.0.1:3001/run
ATEAM_BRIDGE_HOST=127.0.0.1
ATEAM_BRIDGE_PORT=3001
ATEAM_BRIDGE_TIMEOUT_MS=120000
ATEAM_BRIDGE_MAX_BUFFER_BYTES=4194304

ELEVENLABS_API_KEY=YOUR-ELEVENLABS-API-KEY-HERE
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_VOICE_PROF=
ELEVENLABS_VOICE_DEFAULT=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_MS=20000

# Optional shared fallback if per-mode values are not set
OPENAI_MODEL=gpt-4o-mini
