# syntax=docker/dockerfile:1.7
# Root-level Dockerfile for Railway deployment of the dispatch service.
# Build context is the git root; paths reference APPS/dispatch explicitly.

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY APPS/dispatch/package.json APPS/dispatch/package-lock.json ./
RUN npm ci --ignore-scripts

COPY APPS/dispatch/ .
RUN npm run build:prod

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production

COPY APPS/dispatch/package.json APPS/dispatch/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY --from=build /app/dist ./dist

EXPOSE 8080

CMD ["npm", "run", "start"]
