node_modules/
.next/
dist/
build/
.playwright-report/
test-results/
.env
.env.local
.env.*

# additional ignores for monorepo
**/node_modules/
**/.next/
**/dist/
**/build/
**/playwright-report/
**/test-results/
**/coverage/
**/*.log
**/.DS_Store
**/.local/
**/.cache/
**/.turbo/
**/.vite/
**/.env
**/.env.*
!**/.env.example
**/android/.gradle/
**/android/app/build/
**/ios/Pods/

# keep SayWetin trackable in monorepo, but ignore local nested git backup artifacts
APPS/saywetin/.git.backup-*/

# local duplicate clone/tree - not source of truth for this repo
FTC-HOLDING/
.tmp-main-publish/
.tmp-main-publish/**

# local ATEAM temp artifacts
APPS/ATEAM/tmpclaude-*

# ATEAM local runtime data (keep private / avoid noisy diffs)
APPS/ATEAM/memory/**
!APPS/ATEAM/memory/.gitkeep
APPS/ftc-site/APPS/
output/playwright/**
.tmp-agent.json
.tmp-cap.json
