node_modules/
.next/
dist/
build/
.playwright-report/
.playwright-cli/
test-results/
.env
.env.local
.env.*

# additional ignores for monorepo
**/node_modules/
**/.next/
**/dist/
**/build/
**/playwright-report/
**/test-results/
**/coverage/
**/*.log
**/.DS_Store
**/.local/
**/.cache/
**/.turbo/
**/.vite/
**/.env
**/.env.*
!**/.env.example
APPS/una-labs-site/out/
**/android/.gradle/
**/android/app/build/
**/ios/Pods/

# keep SayWetin trackable in monorepo, but ignore local nested git backup artifacts
APPS/saywetin/.git.backup-*/

# local duplicate clone/tree - not source of truth for this repo
FTC-HOLDING/
claude-skills/
claude-skills/**
.tmp-main-publish/
.tmp-main-publish/**
.tmp-ftc-deploy/
.tmp-ftc-deploy/**

# local ATEAM temp artifacts
APPS/ATEAM/tmpclaude-*
APPS/ATEAM/Server/tmpclaude-*

# bundled Git for Windows installer (not source code)
Git/

# local binaries
tmp-bin/
claude.exe

# Claude Code session state (keep project settings, ignore everything else)
.claude/*
!.claude/settings.json

# ATEAM local runtime data (keep private / avoid noisy diffs)
APPS/ATEAM/memory/**
!APPS/ATEAM/memory/.gitkeep
APPS/ftc-site/APPS/
output/playwright/**
.tmp-agent.json
.tmp-cap.json
play-store-key.json
secrets/

# Agent workspace state is local, but recovered repo skills are onboarding assets.
.agents/*
!.agents/skills/
!.agents/skills/**
.windsurf/
